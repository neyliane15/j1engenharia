# ─────────────────────────────────────────────────────────────
# Emptra — variáveis de ambiente (raiz, usadas pelo docker-compose)
# Copie para .env e ajuste. NUNCA versione o .env.
# ─────────────────────────────────────────────────────────────

# Banco
POSTGRES_USER=emptra
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=emptra
DATABASE_URL=postgresql://emptra:troque-esta-senha@postgres:5432/emptra?schema=public

# API
NODE_ENV=production
PORT=3333
API_URL=http://localhost:3333
APP_URL=http://localhost:5173

# Segurança — gere com: openssl rand -hex 48
JWT_SECRET=troque-por-uma-chave-de-96-caracteres-hex
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=30d
WEBHOOK_SECRET=troque-por-outra-chave-hex

# Admin criado pelo seed
SEED_ADMIN_NAME=Administrador Emptra
SEED_ADMIN_EMAIL=admin@emptra.com.br
SEED_ADMIN_PASSWORD=Emptra@2025

# n8n — a API chama estes webhooks
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_DISPATCH=/webhook/emptra-cotacao-disparo
N8N_WEBHOOK_OUTBOUND=/webhook/emptra-whatsapp-envio
N8N_WEBHOOK_AWARD=/webhook/emptra-cotacao-aprovada
N8N_API_KEY=troque-por-uma-chave-compartilhada

# n8n — credenciais do container
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=troque-por-uma-chave-hex-de-32-bytes
GENERIC_TIMEZONE=America/Sao_Paulo
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troque-esta-senha

# WhatsApp (configurado dentro do n8n — ver docs/MANUAL.md)
WHATSAPP_PROVIDER=cloud-api          # cloud-api | evolution
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=emptra-verify
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=emptra

# Frontend (build-time)
VITE_API_URL=http://localhost:3333
